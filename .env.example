# Server Configuration
SERVER_PORT=8080
# Shared secret required by the HTTP API. Empty = no authentication.
API_TOKEN=

# Database Configuration
DB_PATH=ytbloader.db

# Telegram Configuration
TELEGRAM_BOT_TOKEN=

# Discord Configuration
DISCORD_BOT_TOKEN=

# Mattermost Configuration
MATTERMOST_URL=
MATTERMOST_BOT_TOKEN=

# yt-dlp Configuration
YTDLP_PATH=yt-dlp
YTDLP_OUTPUT_DIR=./downloads
# How many downloads run at the same time (metadata lookups are always parallel)
YTDLP_MAX_CONCURRENT=2

# YouTube refuses to serve media without a solved player challenge and a PO
# token, so yt-dlp needs a JS runtime, the EJS solver and a token provider.
# Empty values simply drop the corresponding yt-dlp flag.
# JS runtime for the player challenges, e.g. deno:/path/to/deno
YTDLP_JS_RUNTIME=
# Lets yt-dlp fetch the EJS challenge solver
YTDLP_REMOTE_COMPONENTS=ejs:github
# generate_once.js from bgutil-ytdlp-pot-provider (pip install bgutil-ytdlp-pot-provider)
YTDLP_POT_SCRIPT=
# Player client whose formats are still served over plain HTTPS
YTDLP_PLAYER_CLIENT=web_embedded