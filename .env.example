# Server Configuration
SERVER_PORT=8070
# Shared secret required by the HTTP API. May be empty only when SERVER_HOST is
# a loopback address (127.0.0.1, localhost, ::1); otherwise the server refuses to start.
# Empty SERVER_HOST means all interfaces (then API_TOKEN is required).
# docker-compose always listens on 0.0.0.0 inside the container and needs API_TOKEN.
API_TOKEN=
SERVER_HOST=127.0.0.1

# Database Configuration
DB_PATH=ytbloader.db

# Telegram Configuration
TELEGRAM_BOT_TOKEN=

# Discord Configuration
DISCORD_BOT_TOKEN=

# Mattermost Configuration
MATTERMOST_URL=
MATTERMOST_BOT_TOKEN=

# yt-dlp Configuration
YTDLP_PATH=yt-dlp
YTDLP_OUTPUT_DIR=./downloads
# How many downloads run at the same time (metadata lookups are always parallel)
YTDLP_MAX_CONCURRENT=2

# YouTube refuses to serve media without a solved player challenge and a PO
# token, so yt-dlp needs a JS runtime, the EJS solver and a token provider.
# Empty values simply drop the corresponding yt-dlp flag.
# JS runtime for the player challenges, e.g. deno:/path/to/deno
YTDLP_JS_RUNTIME=
# Lets yt-dlp fetch the EJS challenge solver
YTDLP_REMOTE_COMPONENTS=ejs:github
# generate_once.js from bgutil-ytdlp-pot-provider (pip install bgutil-ytdlp-pot-provider)
YTDLP_POT_SCRIPT=
# Player client whose formats are still served over plain HTTPS
YTDLP_PLAYER_CLIENT=web_embedded
# On by default, but it does nothing without YTDLP_COOKIES (yt-dlp skips it when not logged in). With cookies it writes the video into the watch history of that account
YTDLP_MARK_WATCHED=true
# Netscape cookies file of a YouTube account. Required for MARK_WATCHED: yt-dlp skips it when not logged in
YTDLP_COOKIES=

# Background downloads. Every value below is optional; 0 or empty turns it off.
# How often channels with "/auto <id> on" are checked for new videos to download and send
AUTO_DOWNLOAD_INTERVAL=1h
# Keep at most this many GB of downloaded files; the oldest are deleted first
DOWNLOADS_MAX_GB=0
# Delete downloaded files older than this many days
DOWNLOADS_MAX_AGE_DAYS=0
